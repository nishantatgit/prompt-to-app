# Copy to backend/.env for local development: cp .env.example .env
# The settings at the top are required: the API does not start without them.
# Everything under "Optional" is commented out and shows its default; on Fly
# these are set as secrets or in fly.toml, never in a committed file.

# AI keys. Only needed for builds on the server's own key (free, bought, or
# ALLOW_SERVER_KEYS). With STUB_LLM=true no key is needed at all.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Which provider and model each agent uses: anthropic or openai. When someone
# builds with their own key for the other provider, that provider's default
# model is used instead.
GUARD_PROVIDER=anthropic
GUARD_MODEL=claude-haiku-5-5
ARCHITECT_PROVIDER=anthropic
ARCHITECT_MODEL=claude-sonnet-5-5
TEST_PLANNER_PROVIDER=anthropic
TEST_PLANNER_MODEL=claude-sonnet-5-5
BUILDER_PROVIDER=anthropic
BUILDER_MODEL=claude-sonnet-5-5
VALIDATOR_PROVIDER=anthropic
VALIDATOR_MODEL=claude-sonnet-5-5

# How many times each agent may retry, and the graph's step limit.
ANALYST_MAX_ATTEMPTS=2
ARCHITECT_MAX_ATTEMPTS=2
TEST_PLANNER_MAX_ATTEMPTS=2
BUILDER_MAX_ATTEMPTS=3
VALIDATOR_MAX_ATTEMPTS=2
GRAPH_RECURSION_LIMIT=50

# Where each build's files go, relative to the repo root unless absolute.
WORKSPACES_DIR=workspaces

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# How the app is built: pipeline (one model call, retried through the graph)
# or loop (a model working on files with tools until the build passes).
# BUILDER_MODE=pipeline

# Canned model answers instead of real model calls, for local runs and tests.
# STUB_LLM=false
# Which canned app to build: a folder in agents/stubs.
# STUB_SCENARIO=tip-calculator

# Origins the browser app may call from, separated by commas.
# CORS_ORIGINS=http://localhost:5173

# Where credits, feedback, push subscriptions, trial counts and app photos
# are kept. On Fly this is the volume (/data, set in fly.toml). Unset means
# next to WORKSPACES_DIR, which is lost on deploy.
# DATA_DIR=

# Deploying apps to Vercel. Without VERCEL_TOKEN apps are built but not
# deployed, and apps cannot be changed later.
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# Supabase databases for apps that save data, through the Vercel integration.
# VERCEL_SUPABASE_CONFIG_ID=
# Lets apps with logins skip email confirmation.
# SUPABASE_ACCESS_TOKEN=

# Who pays for the AI. ALLOW_SERVER_KEYS=true builds every request on the keys
# above (local use only). ALLOW_OWN_KEYS=false refuses visitors' own keys.
# ALLOW_SERVER_KEYS=false
# ALLOW_OWN_KEYS=true

# Free builds on Vyskar's Anthropic key: builds per person (0 is off) and
# across everyone per day.
# FREE_TRIAL_BUILDS=0
# FREE_TRIAL_DAILY_CAP=50
# Extra free builds given once for feedback (0 turns the offer off).
# FEEDBACK_BONUS_BUILDS=2

# Bought builds with Razorpay. Off until both keys are set. CREDIT_PACKS is a
# JSON list; unset means the two default packs.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# CREDIT_PACKS=[{"id": "starter", "builds": 5, "price_inr": 499}, {"id": "maker", "builds": 15, "price_inr": 1299}]

# Limits.
# BUILDS_PER_HOUR=3
# MAX_ACTIVE_JOBS=6
# FINISHED_JOB_HOURS=24
# VOICE_PER_HOUR=40

# Voice input with Sarvam. Off when unset.
# SARVAM_API_KEY=

# Web Push when a build finishes. Off until both keys are set.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://vyskar.com

# Photos of finished apps for the end of the build animation.
# APP_SCREENSHOTS=true

# The /admin page's token. Unset means /api/admin/feedback refuses everyone.
# ADMIN_TOKEN=

# LangSmith tracing.
# LANGSMITH_TRACING=
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=
